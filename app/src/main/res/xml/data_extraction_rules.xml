<?xml version="1.0" encoding="utf-8"?>
<!-- 票 41：云端 API Key 只留在本机——不进入云备份与换机迁移（Android 12+）。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="cloud.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cloud.xml" />
    </device-transfer>
</data-extraction-rules>
